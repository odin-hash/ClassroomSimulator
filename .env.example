# Required: Gemini API key for AI student responses and speech-to-text
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Database URL (defaults to SQLite locally)
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Optional: Alternative STT providers
# DEEPGRAM_API_KEY=your_deepgram_key
# ASSEMBLYAI_API_KEY=your_assemblyai_key

# Optional: Frontend API URL (set at build time for production)
# VITE_API_URL=https://your-backend-url.onrender.com
